#!/bin/sh

# Generates an adaptive-width horizontal separator in the terminal with customizable characters and dynamic line overwriting capability.

usage() {
    cmd=$(basename $0)
    echo "usage: $cmd [-c lines] [-s char]" >&2
    echo "       $cmd -c [lines]" >&2
    echo "       $cmd -s [char]" >&2
    exit 1
}

main() {
    cover=0
    char="-"
    
    while getopts "c:s:" opt; do
        case $opt in
            c) cover="$OPTARG" ;;
            s) char="$OPTARG" ;;
            *) usage ;;
        esac
    done
    
    if [ "$(printf '%s' "$char" | wc -m)" -ne 1 ]; then
        echo "Error: Separator must be a single character." >&2
        exit 1
    fi
    
    if command -v tput >/dev/null 2>&1; then
        w=$(tput cols)
    else
        w=${COLUMNS:-80}
    fi
    
    if [ "$cover" -gt 0 ]; then
        printf '\033[%dA\033[0J' "$cover"
    fi
    
    i=0
    while [ "$i" -lt "$w" ]; do
        printf '%s' "$char"
        i=$((i + 1))
    done
    printf '\n'
}

main "$@"
